# Public browser configuration. Restrict the API key to the deployed origins and Google Picker API.
VITE_GOOGLE_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-browser-api-key
VITE_GOOGLE_APP_ID=your-google-cloud-project-number

# Optional account hint. Keep personal values in .env.local, which is ignored by Git.
VITE_GOOGLE_LOGIN_HINT=
